# Copie ce fichier en .env et remplis les valeurs. .env est ignoré par git : ne le committe jamais.

# OpenAI : une seule clé pour le LLM, la reconnaissance vocale et la synthèse vocale
OPENAI_API_KEY=

# Modèles (valeurs par défaut, modifiables)
OPENAI_MODEL=gpt-6-luna
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=fable

# Interface web locale (127.0.0.1 uniquement)
BEEDOO_WEB_PORT=8765

# Accès à l'interface depuis un autre appareil du réseau local (désactivé par défaut : seul cet ordinateur y accède).
# Pour l'activer, décommente les deux lignes. Le mot de passe (8 caractères au moins) est obligatoire, sinon l'accès
# reste limité à cet ordinateur. Attention : la connexion n'est pas chiffrée (http) ; à n'utiliser que chez soi.
# BEEDOO_WEB_HOST=0.0.0.0
# BEEDOO_WEB_PASSWORD=

# Adresse du daemon du robot (volume du haut-parleur)
BEEDOO_DAEMON_URL=http://127.0.0.1:8000
