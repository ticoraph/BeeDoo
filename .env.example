# Copie ce fichier en .env et remplis les valeurs. .env est ignoré par git : ne le committe jamais.

# OpenAI : une seule clé pour le LLM, la reconnaissance vocale et la synthèse vocale
OPENAI_API_KEY=

# Modèles (valeurs par défaut, modifiables)
OPENAI_MODEL=gpt-6-luna
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=fable

# Interface web locale (127.0.0.1 uniquement)
BEEDOO_WEB_PORT=8765
